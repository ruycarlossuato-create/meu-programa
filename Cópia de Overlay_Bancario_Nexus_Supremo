{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[{"file_id":"1Ys5p3k3UVO3UaaNgufyw32jPW38_D24Q","timestamp":1793850665605},{"file_id":"1dgdmuYd02eUOu2w6VuTx1xyD0DiPUTGx","timestamp":1793850521677}],"authorship_tag":"ABX9TyOn2ulnUozyLl6+1zUM84ju"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"markdown","metadata":{"id":"89962829"},"source":["# Sistema de Memória Vetorial Avançado\n","Este notebook contém a implementação de um sistema de memória baseado em embeddings vetoriais com suporte a modularidade, clonagem de estados e simulação de arquitetura fractal/diferencial de dados."]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"a219413f","executionInfo":{"status":"ok","timestamp":1793850504666,"user_tz":180,"elapsed":40,"user":{"displayName":"Ruy Carlos suato","userId":"06553808173356404075"}},"outputId":"606dc6dc-d539-470b-f21d-df665ee57aae"},"source":["import numpy as np\n","import json\n","from typing import Dict, List, Tuple\n","\n","class VectorMemory:\n","    \"\"\"Classe base para armazenamento e recuperação de memória vetorial.\"\"\"\n","    def __init__(self, dimension: int = 128):\n","        self.dimension = dimension\n","        self.memory_store: Dict[str, np.ndarray] = {}\n","        self.meta_store: Dict[str, dict] = {}\n","\n","    def add_memory(self, key: str, vector: np.ndarray, metadata: dict = None):\n","        if vector.shape[0] != self.dimension:\n","            raise ValueError(f\"Dimensão do vetor deve ser {self.dimension}\")\n","        self.memory_store[key] = vector\n","        self.meta_store[key] = metadata or {}\n","\n","    def retrieve_similar(self, query_vector: np.ndarray, top_k: int = 3) -> List[Tuple[str, float, dict]]:\n","        if not self.memory_store:\n","            return []\n","\n","        results = []\n","        for key, vector in self.memory_store.items():\n","            # Cálculo de similaridade por cosseno\n","            norm_q = np.linalg.norm(query_vector)\n","            norm_v = np.linalg.norm(vector)\n","            if norm_q == 0 or norm_v == 0:\n","                similarity = 0.0\n","            else:\n","                similarity = np.dot(query_vector, vector) / (norm_q * norm_v)\n","            results.append((key, float(similarity), self.meta_store[key]))\n","\n","        results.sort(key=lambda x: x[1], reverse=True)\n","        return results[:top_k]\n","\n","# Demonstração básica de inicialização\n","mem = VectorMemory(dimension=8)\n","test_vector = np.array([0.1, 0.2, 0.8, 0.0, 0.1, 0.5, 0.3, 0.1])\n","mem.add_memory(\"memoria_teste_1\", test_vector, {\"origem\": \"interacao_usuario\"})\n","print(\"Armazenamento de teste criado com sucesso.\")"],"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Armazenamento de teste criado com sucesso.\n"]}]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"da1c907d","executionInfo":{"status":"ok","timestamp":1793850504686,"user_tz":180,"elapsed":16,"user":{"displayName":"Ruy Carlos suato","userId":"06553808173356404075"}},"outputId":"733c390f-d623-48f0-8c10-4a6f2141ac27"},"source":["import copy\n","import math\n","\n","class ModularCloner:\n","    \"\"\"Clonador Modular: Permite clonar e isolar subsistemas de memória independentes.\"\"\"\n","    @staticmethod\n","    def clone(memory: VectorMemory) -> VectorMemory:\n","        new_mem = VectorMemory(dimension=memory.dimension)\n","        new_mem.memory_store = copy.deepcopy(memory.memory_store)\n","        new_mem.meta_store = copy.deepcopy(memory.meta_store)\n","        return new_mem\n","\n","class FractalCloner:\n","    \"\"\"Clonador Fractal: Clona a estrutura em diferentes níveis de resolução vetorial de forma auto-similar.\"\"\"\n","    @staticmethod\n","    def clone_fractal(memory: VectorMemory, depth: int = 2) -> List[VectorMemory]:\n","        clones = []\n","        for i in range(1, depth + 1):\n","            scale_factor = 1.0 / math.sqrt(i)\n","            scaled_mem = VectorMemory(dimension=memory.dimension)\n","            for key, vec in memory.memory_store.items():\n","                scaled_mem.add_memory(f\"{key}_fractal_lvl_{i}\", vec * scale_factor, copy.deepcopy(memory.meta_store[key]))\n","            clones.append(scaled_mem)\n","        return clones\n","\n","class DifferentialCloner:\n","    \"\"\"Clonador Diferencial: Identifica e armazena apenas as mudanças e variações entre estados de memória.\"\"\"\n","    @staticmethod\n","    def calculate_delta(base_mem: VectorMemory, target_mem: VectorMemory) -> Dict[str, np.ndarray]:\n","        deltas = {}\n","        for key, vec in target_mem.memory_store.items():\n","            if key in base_mem.memory_store:\n","                deltas[key] = vec - base_mem.memory_store[key]\n","            else:\n","                deltas[key] = vec\n","        return deltas\n","\n","print(\"Tecnologias de clonagem (Modular, Fractal e Diferencial) inicializadas com sucesso!\")"],"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Tecnologias de clonagem (Modular, Fractal e Diferencial) inicializadas com sucesso!\n"]}]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"aa21da94","executionInfo":{"status":"ok","timestamp":1793850504721,"user_tz":180,"elapsed":33,"user":{"displayName":"Ruy Carlos suato","userId":"06553808173356404075"}},"outputId":"645b8d57-da74-4782-9879-9bc36cd7f591"},"source":["# Escrevendo o arquivo do software completo com Interface Gráfica (Tkinter) e Licença\n","\n","app_code = \"\"\"\n","import tkinter as tk\n","from tkinter import messagebox\n","import numpy as np\n","import sys\n","\n","# Chave de licença simples predefinida para validação\n","LICENSE_KEY = \"NEXUS-M3-FRACTAL-99\"\n","\n","class LicensedApp:\n","    def __init__(self, root):\n","        self.root = root\n","        self.root.