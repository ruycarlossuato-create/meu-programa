t ImportError:\n","    !pip install cryptography\n","    from cryptography.fernet import Fernet\n","\n","import json\n","\n","class SecureBankBridge:\n","    \"\"\"Simulador de ponte de dados bancários segura usando criptografia AES (Fernet).\"\"\"\n","    def __init__(self):\n","        # Geração de chave simétrica padrão para simular o canal seguro de comunicação\n","        self.key = Fernet.generate_key()\n","        self.cipher = Fernet(self.key)\n","\n","    def encrypt_transaction(self, transaction_data: dict) -> bytes:\n","        \"\"\"Criptografa os dados da transação antes do envio.\"\"\"\n","        raw_data = json.dumps(transaction_data).encode('utf-8')\n","        return self.cipher.encrypt(raw_data)\n","\n","    def decrypt_transaction(self, encrypted_data: bytes) -> dict:\n","        \"\"\"Decodifica com segurança a transação no destino.\"\"\"\n","        decrypted_raw = self.cipher.decrypt(encrypted_data)\n","        return json.loads(decrypted_raw.decode('utf-8'))\n","\n","# Exemplo de payload simulando uma integração direta empresa-banco sem burocracia\n","bridge = SecureBankBridge()\n","transaction = {\n","    \"origem\": \"Empresa_Parceira_A\",\n","    \"destino\": \"Banco_Parceiro_B\",\n","    \"valor\": 250000.00,\n","    \"moeda\": \"BRL\",\n","    \"status_integracao\": \"Direto\"\n","}\n","\n","ciphertext = bridge.encrypt_transaction(transaction)\n","print(\"Dados criptografados transmitidos:\", ciphertext[:50], \"...\")\n","\n","decrypted_payload = bridge.decrypt_transaction(ciphertext)\n","print(\"Dados recebidos e decodificados com sucesso:\", decrypted_payload)"],"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Dados criptografados transmitidos: b'gAAAAABq6_yI7wbxtN6zA6ebdLmZJQ_-x1fLT35vd46eagnPk_' ...\n","Dados recebidos e decodificados com sucesso: {'origem': 'Empresa_Parceira_A', 'destino': 'Banco_Parceiro_B', 'valor': 250000.0, 'moeda': 'BRL', 'status_integracao': 'Direto'}\n"]}]},{"cell_type":"code